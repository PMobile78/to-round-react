<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing to back up or move to a new phone: tasks and settings live in Firestore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
