{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json",
        "predeploy": [
            "node \"$PROJECT_DIR/scripts/stage0-deploy-guard.js\""
        ]
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firestore-debug.log",
                "test"
            ],
            "predeploy": [
                "node \"$PROJECT_DIR/scripts/stage0-deploy-guard.js\""
            ]
        }
    ],
    "hosting": {
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ]
    },
    "emulators": {
        "auth": {
            "port": 9099
        },
        "firestore": {
            "port": 8180
        },
        "ui": {
            "enabled": false
        },
        "singleProjectMode": true
    }
}
